# Copy to .env and adjust. All variables are prefixed MP_; nested settings
# use a double underscore, e.g. MP_DB__HOST. See src/marketpulse/config.py.

# --- App ---
# One of: local | test | ci | staging | production
MP_ENV=local
# One of: DEBUG | INFO | WARNING | ERROR | CRITICAL
MP_LOG_LEVEL=INFO

# --- Postgres ---
# Host-exposed port defaults to 5433 (not 5432) to avoid clashing with a
# machine-local Postgres install — see docker/docker-compose.dev.yml.
MP_DB__HOST=localhost
MP_DB__PORT=5433
MP_DB__USER=marketpulse
MP_DB__PASSWORD=marketpulse
MP_DB__NAME=marketpulse

# --- RabbitMQ ---
MP_RABBITMQ__HOST=localhost
MP_RABBITMQ__PORT=5672
MP_RABBITMQ__USER=marketpulse
MP_RABBITMQ__PASSWORD=marketpulse
MP_RABBITMQ__VHOST=/

# --- Features ---
# In-memory window state bounds for the streaming feature pipeline.
# max_history_hours must exceed the widest feature lookback (realised_vol_24h,
# 24h) with real margin -- see features.windows.DEFAULT_MAX_HISTORY.
MP_FEATURES__MAX_HISTORY_HOURS=27
MP_FEATURES__MAX_BUFFER_POINTS=10000
# Consecutive-tick gap beyond which a row is flagged has_gap=true.
MP_FEATURES__GAP_THRESHOLD_SECONDS=120

# --- MLflow ---
# Tracking server URI (see docker/docker-compose.yml "mlflow" service). Host
# port 5000; container-to-container traffic uses the service name "mlflow".
MP_MLFLOW__TRACKING_URI=http://localhost:5000
MP_MLFLOW__REGISTRY_MODEL_NAME=marketpulse
MP_MLFLOW__EXPERIMENT_NAME=marketpulse

# --- MLflow's own backend (Postgres db) + artifact store (MinIO) ---
# Consumed directly by docker-compose, not by the app -- the app only ever
# talks to MP_MLFLOW__TRACKING_URI; the tracking server proxies artifact
# reads/writes so no S3 credentials are needed client-side.
MP_MLFLOW_DB__NAME=mlflow
MP_MINIO__ROOT_USER=marketpulse
MP_MINIO__ROOT_PASSWORD=marketpulse-minio
MP_MINIO__BUCKET=mlflow

# --- Data quality thresholds (Phase 4, monitoring.quality) ---
# Freshness: newest tick older than this fails the check (dag_data_quality,
# hourly). Completeness: actual/expected row ratio in the check window below
# this fails. Distribution: relative shift in a feature's mean beyond this
# fails -- a sanity check, not PSI-based drift (that's Phase 6).
MP_MONITORING__FRESHNESS_MAX_LAG_MINUTES=10
MP_MONITORING__EXPECTED_TICK_INTERVAL_SECONDS=10
MP_MONITORING__COMPLETENESS_WINDOW_HOURS=1
MP_MONITORING__COMPLETENESS_MIN_RATIO=0.95
MP_MONITORING__DISTRIBUTION_WINDOW_HOURS=1
MP_MONITORING__DISTRIBUTION_REFERENCE_WINDOW_HOURS=24
MP_MONITORING__DISTRIBUTION_MAX_RELATIVE_SHIFT=0.5

# --- Object storage the app writes to directly (dag_data_archival) ---
# Same MinIO instance as MLflow's artifact store, different bucket -- unlike
# MLflow (which proxies artifact I/O), archival writes Parquet exports
# straight to the bucket, so it needs its own client credentials here.
MP_OBJECT_STORE__ENDPOINT_URL=http://localhost:9000
MP_OBJECT_STORE__ACCESS_KEY=marketpulse
MP_OBJECT_STORE__SECRET_KEY=marketpulse-minio
MP_OBJECT_STORE__ARCHIVE_BUCKET=marketpulse-archive
MP_OBJECT_STORE__HOT_RETENTION_MONTHS=6

# --- Airflow (Phase 4) ---
# Consumed directly by docker-compose (see x-airflow-common), not by
# marketpulse's own Settings -- Airflow reads these as plain
# AIRFLOW__CORE__FERNET_KEY / AIRFLOW__API__SECRET_KEY env vars itself.
# The values below are dev-only defaults (same trust level as
# MP_DB__PASSWORD's committed default above) -- generate real ones for
# anything beyond a local machine:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#   python -c "import secrets; print(secrets.token_hex(32))"
MP_AIRFLOW_DB__NAME=airflow
MP_AIRFLOW__FERNET_KEY=TjTC9jZluasp2_19DbdD-bAuUEdv9q0GOmASNlwi4OQ=
MP_AIRFLOW__SECRET_KEY=7632b8dac42a6827f828605e978c1a7b51e59f105a17bb69ec82f5cfc7f8b9c
